{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // ES2022 is the published baseline. DOM supplies the types for fetch,
    // Response, Headers, Blob, AbortController and URL — all native in Node 18+.
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    // No @types/node. Its presence is what lets Buffer and node: imports
    // typecheck silently; without it they are a compile error.
    "types": [],
    "isolatedDeclarations": true, // forces explicit types on every export
    // No source maps in the published package: the .d.ts map pointed at src/,
    // which `files: ["dist"]` never ships, and the .js map was 3x the size of
    // the code. Flip this back to true if consumers need to debug into source.
    "declarationMap": false,
    "sourceMap": false,
    "rootDir": ".",
    "outDir": ".tsbuild" // tsdown owns dist/; tsc only type-checks
  },
  "include": ["src", "test"]
}
