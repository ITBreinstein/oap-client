r\": {\"dataLabels\": {\"position\": \"top\"}}}, \"tooltip\": {\"y\": {\"formatter\": \"function(val){ return Number(val).toFixed(2); }\"}}};\n                // Create chart in the specified container\n                var chart = new ApexCharts(document.querySelector(\"#chart-bar-minavgmax-8de11668e7744cbfa211490e6e6d71e4\"), options);\n                chart.render();\n            })();\n            </script>", "contentMediaType": "text/html"}, "title": "Drop in html om grafiek weer te geven.", "description": "HTML die een grafiek opbouwt (ApexCharts) waarin de minimale, maximale en gemiddelde loopafstand van alle woningen wordt weergeven."}}, "links": [{"href": "https://ca-dtp-beleidsnormenapi-dev.mangosand-ad64f45c.westeurope.azurecontainerapps.io/api/processes/regel_300", "rel": "self", "type": "application/json", "title": "This document"}, {"href": "https://analyze.nl/", "rel": "author", "type": "text/html", "hreflang": "nl", "title": "OGC Process API gateway original author: Analyze"}]}