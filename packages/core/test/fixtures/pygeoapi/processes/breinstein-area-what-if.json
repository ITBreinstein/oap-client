{
    "version":"1.0.0",
    "id":"breinstein-area-what-if",
    "title":"Points in an area",
    "description":"Counts the points of a what-if layer that fall inside an area, and measures the area. Its inputs are described as the Beleidsnormen API describes its own.",
    "jobControlOptions":[
        "sync-execute",
        "async-execute"
    ],
    "keywords":[
        "geojson",
        "feature collection",
        "what-if",
        "testbed"
    ],
    "links":[
        {
            "type":"text/html",
            "rel":"about",
            "title":"information",
            "href":"https://example.org/process",
            "hreflang":"en-US"
        },
        {
            "type":"application/json",
            "rel":"self",
            "href":"http://localhost:5080/processes/breinstein-area-what-if?f=json",
            "title":"Process description as JSON",
            "hreflang":"en-US"
        },
        {
            "type":"text/html",
            "rel":"alternate",
            "href":"http://localhost:5080/processes/breinstein-area-what-if?f=html",
            "title":"Process description as HTML",
            "hreflang":"en-US"
        },
        {
            "type":"text/html",
            "rel":"http://www.opengis.net/def/rel/ogc/1.0/job-list",
            "href":"http://localhost:5080/jobs?f=html",
            "title":"Jobs list as HTML",
            "hreflang":"en-US"
        },
        {
            "type":"application/json",
            "rel":"http://www.opengis.net/def/rel/ogc/1.0/job-list",
            "href":"http://localhost:5080/jobs?f=json",
            "title":"Jobs list as JSON",
            "hreflang":"en-US"
        },
        {
            "type":"application/json",
            "rel":"http://www.opengis.net/def/rel/ogc/1.0/execute",
            "href":"http://localhost:5080/processes/breinstein-area-what-if/execution?f=json",
            "title":"Execution for this process as JSON",
            "hreflang":"en-US"
        }
    ],
    "inputs":{
        "geometry":{
            "schema":{
                "example":{
                    "value":{
                        "type":"Polygon",
                        "coordinates":[
                            [
                                [
                                    5.118,
                                    52.089
                                ],
                                [
                                    5.124,
                                    52.089
                                ],
                                [
                                    5.124,
                                    52.093
                                ],
                                [
                                    5.118,
                                    52.093
                                ],
                                [
                                    5.118,
                                    52.089
                                ]
                            ]
                        ]
                    },
                    "format":{
                        "mediatype":"application/geo+json"
                    }
                },
                "oneOf":[
                    {
                        "required":[
                            "type",
                            "coordinates"
                        ],
                        "type":"object",
                        "format":"geojson-geometry",
                        "contentMediaType":"application/geo+json",
                        "properties":{
                            "type":{
                                "enum":[
                                    "Polygon"
                                ],
                                "type":"string"
                            },
                            "coordinates":{
                                "type":"array",
                                "items":{
                                    "minItems":4,
                                    "type":"array",
                                    "items":{
                                        "minItems":2,
                                        "type":"array",
                                        "items":{
                                            "type":"number"
                                        }
                                    }
                                }
                            }
                        }
                    },
                    {
                        "required":[
                            "type",
                            "coordinates"
                        ],
                        "type":"object",
                        "format":"geojson-geometry",
                        "contentMediaType":"application/geo+json",
                        "properties":{
                            "type":{
                                "enum":[
                                    "MultiPolygon"
                                ],
                                "type":"string"
                            },
                            "coordinates":{
                                "type":"array",
                                "items":{
                                    "type":"array",
                                    "items":{
                                        "minItems":4,
                                        "type":"array",
                                        "items":{
                                            "minItems":2,
                                            "type":"array",
                                            "items":{
                                                "type":"number"
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                ]
            },
            "minOccurs":1,
            "title":"The area",
            "description":"The area to count in (Polygon or MultiPolygon), in longitude and latitude.",
            "maxOccurs":1
        },
        "nieuwe_punten":{
            "schema":{
                "required":[
                    "type",
                    "features"
                ],
                "type":"object",
                "example":{
                    "type":"FeatureCollection",
                    "features":[
                        {
                            "type":"Feature",
                            "geometry":{
                                "type":"Point",
                                "coordinates":[
                                    5.121,
                                    52.091
                                ]
                            },
                            "properties":{}
                        }
                    ]
                },
                "properties":{
                    "type":{
                        "enum":[
                            "FeatureCollection"
                        ],
                        "type":"string"
                    },
                    "features":{
                        "type":"array",
                        "items":{
                            "required":[
                                "type",
                                "geometry",
                                "properties"
                            ],
                            "type":"object",
                            "properties":{
                                "type":{
                                    "enum":[
                                        "Feature"
                                    ],
                                    "type":"string"
                                },
                                "geometry":{
                                    "oneOf":[
                                        {
                                            "required":[
                                                "type",
                                                "coordinates"
                                            ],
                                            "type":"object",
                                            "properties":{
                                                "type":{
                                                    "enum":[
                                                        "Point"
                                                    ],
                                                    "type":"string"
                                                },
                                                "coordinates":{
                                                    "minItems":2,
                                                    "type":"array",
                                                    "items":{
                                                        "type":"number"
                                                    }
                                                }
                                            }
                                        }
                                    ]
                                },
                                "properties":{
                                    "type":"object",
                                    "nullable":true,
                                    "properties":{}
                                }
                            }
                        }
                    }
                }
            },
            "minOccurs":0,
            "title":"nieuwe_punten",
            "description":"New points to count: one or more FeatureCollections of points, in longitude and latitude.",
            "maxOccurs":"unbounded"
        }
    },
    "outputs":{
        "result":{
            "title":"Points in the area",
            "description":"A JSON object: \"inside\", how many points fall in the area or on its edge; \"points\", how many were sent; \"area_m2\", the geodesic area in square metres; \"points_as\", how nieuwe_punten arrived (\"array\", \"single\" or \"absent\").",
            "schema":{
                "type":"object",
                "contentMediaType":"application/json"
            }
        }
    },
    "example":{
        "inputs":{
            "geometry":{
                "value":{
                    "type":"Polygon",
                    "coordinates":[
                        [
                            [
                                5.118,
                                52.089
                            ],
                            [
                                5.124,
                                52.089
                            ],
                            [
                                5.124,
                                52.093
                            ],
                            [
                                5.118,
                                52.093
                            ],
                            [
                                5.118,
                                52.089
                            ]
                        ]
                    ]
                },
                "mediaType":"application/geo+json"
            },
            "nieuwe_punten":[
                {
                    "value":{
                        "type":"FeatureCollection",
                        "features":[
                            {
                                "type":"Feature",
                                "geometry":{
                                    "type":"Point",
                                    "coordinates":[
                                        5.121,
                                        52.091
                                    ]
                                },
                                "properties":{}
                            }
                        ]
                    },
                    "mediaType":"application/geo+json"
                }
            ]
        }
    },
    "outputTransmission":[
        "value"
    ]
}