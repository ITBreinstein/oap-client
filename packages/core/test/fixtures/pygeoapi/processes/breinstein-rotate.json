{
    "version":"1.0.0",
    "id":"breinstein-rotate",
    "title":"Rotate a polygon a quarter turn",
    "description":"Takes one GeoJSON polygon and returns it rotated 90 degrees counter-clockwise about the centre of its bounding box, as it looks on a map. Exists so that a geometry can go in and a different geometry come out, from a browser.",
    "jobControlOptions":[
        "sync-execute",
        "async-execute"
    ],
    "keywords":[
        "geojson",
        "polygon",
        "testbed"
    ],
    "links":[
        {
            "type":"text/html",
            "rel":"about",
            "title":"information",
            "href":"https://example.org/process",
            "hreflang":"en-US"
        },
        {
            "type":"application/json",
            "rel":"self",
            "href":"http://localhost:5080/processes/breinstein-rotate?f=json",
            "title":"Process description as JSON",
            "hreflang":"en-US"
        },
        {
            "type":"text/html",
            "rel":"alternate",
            "href":"http://localhost:5080/processes/breinstein-rotate?f=html",
            "title":"Process description as HTML",
            "hreflang":"en-US"
        },
        {
            "type":"text/html",
            "rel":"http://www.opengis.net/def/rel/ogc/1.0/job-list",
            "href":"http://localhost:5080/jobs?f=html",
            "title":"Jobs list as HTML",
            "hreflang":"en-US"
        },
        {
            "type":"application/json",
            "rel":"http://www.opengis.net/def/rel/ogc/1.0/job-list",
            "href":"http://localhost:5080/jobs?f=json",
            "title":"Jobs list as JSON",
            "hreflang":"en-US"
        },
        {
            "type":"application/json",
            "rel":"http://www.opengis.net/def/rel/ogc/1.0/execute",
            "href":"http://localhost:5080/processes/breinstein-rotate/execution?f=json",
            "title":"Execution for this process as JSON",
            "hreflang":"en-US"
        }
    ],
    "inputs":{
        "polygon":{
            "title":"Polygon",
            "description":"A GeoJSON Polygon geometry, as a qualified value or bare; not wrapped in a Feature. Holes are rotated with it.",
            "schema":{
                "type":"object",
                "format":"geojson-polygon",
                "required":[
                    "type",
                    "coordinates"
                ],
                "properties":{
                    "type":{
                        "type":"string",
                        "enum":[
                            "Polygon"
                        ]
                    },
                    "coordinates":{
                        "type":"array",
                        "minItems":1,
                        "items":{
                            "type":"array",
                            "minItems":4,
                            "items":{
                                "type":"array",
                                "minItems":2,
                                "items":{
                                    "type":"number"
                                }
                            }
                        }
                    }
                }
            },
            "minOccurs":1,
            "maxOccurs":1,
            "keywords":[
                "geojson"
            ]
        }
    },
    "outputs":{
        "rotated":{
            "title":"Rotated polygon",
            "description":"The polygon rotated 90 degrees counter-clockwise, as a GeoJSON Polygon geometry.",
            "schema":{
                "type":"object",
                "contentMediaType":"application/geo+json"
            }
        }
    },
    "example":{
        "inputs":{
            "polygon":{
                "value":{
                    "type":"Polygon",
                    "coordinates":[
                        [
                            [
                                5.0,
                                52.0
                            ],
                            [
                                5.2,
                                52.0
                            ],
                            [
                                5.2,
                                52.1
                            ],
                            [
                                5.0,
                                52.1
                            ],
                            [
                                5.0,
                                52.0
                            ]
                        ]
                    ]
                },
                "mediaType":"application/geo+json"
            }
        }
    },
    "outputTransmission":[
        "value"
    ]
}