{
    "version":"1.0.0",
    "id":"breinstein-kml",
    "title":"An area as KML, with HTML in it",
    "description":"Returns the area given as four KML Placemarks: a polygon whose description is HTML, a point with ExtendedData Data, a line with SchemaData and a MultiGeometry. Exists so that a client's KML reading can be tested.",
    "jobControlOptions":[
        "sync-execute",
        "async-execute"
    ],
    "keywords":[
        "kml",
        "testbed"
    ],
    "links":[
        {
            "type":"application/json",
            "rel":"self",
            "href":"http://localhost:5080/processes/breinstein-kml?f=json",
            "title":"Process description as JSON",
            "hreflang":"en-US"
        },
        {
            "type":"text/html",
            "rel":"alternate",
            "href":"http://localhost:5080/processes/breinstein-kml?f=html",
            "title":"Process description as HTML",
            "hreflang":"en-US"
        },
        {
            "type":"text/html",
            "rel":"http://www.opengis.net/def/rel/ogc/1.0/job-list",
            "href":"http://localhost:5080/jobs?f=html",
            "title":"Jobs list as HTML",
            "hreflang":"en-US"
        },
        {
            "type":"application/json",
            "rel":"http://www.opengis.net/def/rel/ogc/1.0/job-list",
            "href":"http://localhost:5080/jobs?f=json",
            "title":"Jobs list as JSON",
            "hreflang":"en-US"
        },
        {
            "type":"application/json",
            "rel":"http://www.opengis.net/def/rel/ogc/1.0/execute",
            "href":"http://localhost:5080/processes/breinstein-kml/execution?f=json",
            "title":"Execution for this process as JSON",
            "hreflang":"en-US"
        }
    ],
    "inputs":{
        "area":{
            "title":"Area",
            "description":"A bounding box in longitude and latitude. A small box in Utrecht when left out.",
            "schema":{
                "type":"object",
                "format":"ogc-bbox",
                "required":[
                    "bbox"
                ],
                "properties":{
                    "bbox":{
                        "type":"array",
                        "minItems":4,
                        "maxItems":4,
                        "items":{
                            "type":"number"
                        }
                    },
                    "crs":{
                        "type":"string",
                        "format":"uri",
                        "enum":[
                            "http://www.opengis.net/def/crs/OGC/1.3/CRS84"
                        ],
                        "default":"http://www.opengis.net/def/crs/OGC/1.3/CRS84"
                    }
                }
            },
            "minOccurs":0,
            "maxOccurs":1
        }
    },
    "outputs":{
        "placemarks":{
            "title":"Placemarks",
            "description":"Four Placemarks in the area, in KML.",
            "schema":{
                "type":"string",
                "contentMediaType":"application/vnd.google-earth.kml+xml"
            }
        }
    },
    "example":{
        "inputs":{
            "area":{
                "bbox":[
                    5.118,
                    52.089,
                    5.124,
                    52.093
                ]
            }
        }
    },
    "outputTransmission":[
        "value"
    ]
}