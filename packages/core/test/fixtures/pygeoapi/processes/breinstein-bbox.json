{
    "version":"1.0.0",
    "id":"breinstein-bbox",
    "title":"Bounding box to feature",
    "description":"Takes one bounding box and returns it as a GeoJSON Feature whose geometry is the box as a polygon. Exists so that a bounding-box input can be drawn, encoded and sent from a browser.",
    "jobControlOptions":[
        "sync-execute",
        "async-execute"
    ],
    "keywords":[
        "bbox",
        "echo",
        "testbed"
    ],
    "links":[
        {
            "type":"text/html",
            "rel":"about",
            "title":"information",
            "href":"https://example.org/process",
            "hreflang":"en-US"
        },
        {
            "type":"application/json",
            "rel":"self",
            "href":"http://localhost:5080/processes/breinstein-bbox?f=json",
            "title":"Process description as JSON",
            "hreflang":"en-US"
        },
        {
            "type":"text/html",
            "rel":"alternate",
            "href":"http://localhost:5080/processes/breinstein-bbox?f=html",
            "title":"Process description as HTML",
            "hreflang":"en-US"
        },
        {
            "type":"text/html",
            "rel":"http://www.opengis.net/def/rel/ogc/1.0/job-list",
            "href":"http://localhost:5080/jobs?f=html",
            "title":"Jobs list as HTML",
            "hreflang":"en-US"
        },
        {
            "type":"application/json",
            "rel":"http://www.opengis.net/def/rel/ogc/1.0/job-list",
            "href":"http://localhost:5080/jobs?f=json",
            "title":"Jobs list as JSON",
            "hreflang":"en-US"
        },
        {
            "type":"application/json",
            "rel":"http://www.opengis.net/def/rel/ogc/1.0/execute",
            "href":"http://localhost:5080/processes/breinstein-bbox/execution?f=json",
            "title":"Execution for this process as JSON",
            "hreflang":"en-US"
        }
    ],
    "inputs":{
        "bbox":{
            "title":"Bounding box",
            "description":"The area to return, as minimum and maximum longitude and latitude in CRS84.",
            "schema":{
                "type":"object",
                "format":"ogc-bbox",
                "required":[
                    "bbox"
                ],
                "properties":{
                    "bbox":{
                        "type":"array",
                        "minItems":4,
                        "maxItems":4,
                        "items":{
                            "type":"number"
                        }
                    },
                    "crs":{
                        "type":"string",
                        "format":"uri",
                        "default":"http://www.opengis.net/def/crs/OGC/1.3/CRS84",
                        "enum":[
                            "http://www.opengis.net/def/crs/OGC/1.3/CRS84"
                        ]
                    }
                }
            },
            "minOccurs":1,
            "maxOccurs":1,
            "keywords":[
                "bbox"
            ]
        }
    },
    "outputs":{
        "feature":{
            "title":"Feature",
            "description":"The bounding box as a GeoJSON Feature with a polygon geometry.",
            "schema":{
                "type":"object",
                "contentMediaType":"application/geo+json"
            }
        }
    },
    "example":{
        "inputs":{
            "bbox":{
                "bbox":[
                    3.0,
                    50.7,
                    7.0,
                    53.6
                ],
                "crs":"http://www.opengis.net/def/crs/OGC/1.3/CRS84"
            }
        }
    },
    "outputTransmission":[
        "value"
    ]
}