{
    "version":"1.0.0",
    "id":"breinstein-rd-link",
    "title":"Areas in RD New, by reference",
    "description":"Returns one output by reference: a link to three fixed features on this server, in RD New (EPSG:28992) or in CRS84, whichever is asked for. The features API sends Content-Crs.",
    "jobControlOptions":[
        "sync-execute",
        "async-execute"
    ],
    "outputTransmission":[
        "value"
    ],
    "keywords":[
        "reference",
        "crs",
        "rd-new",
        "testbed"
    ],
    "links":[
        {
            "type":"application/json",
            "rel":"self",
            "href":"http://localhost:5080/processes/breinstein-rd-link?f=json",
            "title":"Process description as JSON",
            "hreflang":"en-US"
        },
        {
            "type":"text/html",
            "rel":"alternate",
            "href":"http://localhost:5080/processes/breinstein-rd-link?f=html",
            "title":"Process description as HTML",
            "hreflang":"en-US"
        },
        {
            "type":"text/html",
            "rel":"http://www.opengis.net/def/rel/ogc/1.0/job-list",
            "href":"http://localhost:5080/jobs?f=html",
            "title":"Jobs list as HTML",
            "hreflang":"en-US"
        },
        {
            "type":"application/json",
            "rel":"http://www.opengis.net/def/rel/ogc/1.0/job-list",
            "href":"http://localhost:5080/jobs?f=json",
            "title":"Jobs list as JSON",
            "hreflang":"en-US"
        },
        {
            "type":"application/json",
            "rel":"http://www.opengis.net/def/rel/ogc/1.0/execute",
            "href":"http://localhost:5080/processes/breinstein-rd-link/execution?f=json",
            "title":"Execution for this process as JSON",
            "hreflang":"en-US"
        }
    ],
    "inputs":{
        "crs":{
            "title":"Coordinate system",
            "description":"The coordinate system the link asks for. RD New when left out.",
            "schema":{
                "type":"string",
                "enum":[
                    "http://www.opengis.net/def/crs/EPSG/0/28992",
                    "http://www.opengis.net/def/crs/OGC/1.3/CRS84"
                ],
                "default":"http://www.opengis.net/def/crs/EPSG/0/28992"
            },
            "minOccurs":0,
            "maxOccurs":1
        }
    },
    "outputs":{
        "areas":{
            "title":"Areas",
            "description":"A link to the features, in the coordinate system asked for. Always by reference.",
            "schema":{
                "type":"object",
                "contentMediaType":"application/geo+json"
            }
        }
    },
    "example":{
        "inputs":{
            "crs":"http://www.opengis.net/def/crs/EPSG/0/28992"
        }
    }
}