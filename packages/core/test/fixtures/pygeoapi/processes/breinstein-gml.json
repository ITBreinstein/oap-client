{
    "version":"1.0.0",
    "id":"breinstein-gml",
    "title":"An area as GML, as ZOO-Project writes it",
    "description":"Returns the area given as one polygon feature and its centre as a point feature, in GML 2 as an OGR feature collection, with srsName EPSG:4326, EPSG:28992 or none. Exists so that a client's GML reading can be tested.",
    "jobControlOptions":[
        "sync-execute",
        "async-execute"
    ],
    "keywords":[
        "gml",
        "testbed"
    ],
    "links":[
        {
            "type":"application/json",
            "rel":"self",
            "href":"http://localhost:5080/processes/breinstein-gml?f=json",
            "title":"Process description as JSON",
            "hreflang":"en-US"
        },
        {
            "type":"text/html",
            "rel":"alternate",
            "href":"http://localhost:5080/processes/breinstein-gml?f=html",
            "title":"Process description as HTML",
            "hreflang":"en-US"
        },
        {
            "type":"text/html",
            "rel":"http://www.opengis.net/def/rel/ogc/1.0/job-list",
            "href":"http://localhost:5080/jobs?f=html",
            "title":"Jobs list as HTML",
            "hreflang":"en-US"
        },
        {
            "type":"application/json",
            "rel":"http://www.opengis.net/def/rel/ogc/1.0/job-list",
            "href":"http://localhost:5080/jobs?f=json",
            "title":"Jobs list as JSON",
            "hreflang":"en-US"
        },
        {
            "type":"application/json",
            "rel":"http://www.opengis.net/def/rel/ogc/1.0/execute",
            "href":"http://localhost:5080/processes/breinstein-gml/execution?f=json",
            "title":"Execution for this process as JSON",
            "hreflang":"en-US"
        }
    ],
    "inputs":{
        "area":{
            "title":"Area",
            "description":"A bounding box in longitude and latitude. A small box in Utrecht when left out.",
            "schema":{
                "type":"object",
                "format":"ogc-bbox",
                "required":[
                    "bbox"
                ],
                "properties":{
                    "bbox":{
                        "type":"array",
                        "minItems":4,
                        "maxItems":4,
                        "items":{
                            "type":"number"
                        }
                    },
                    "crs":{
                        "type":"string",
                        "format":"uri",
                        "enum":[
                            "http://www.opengis.net/def/crs/OGC/1.3/CRS84"
                        ],
                        "default":"http://www.opengis.net/def/crs/OGC/1.3/CRS84"
                    }
                }
            },
            "minOccurs":0,
            "maxOccurs":1
        },
        "crs":{
            "title":"srsName",
            "description":"The srsName the GML carries: EPSG:4326, EPSG:28992, or none.",
            "schema":{
                "type":"string",
                "enum":[
                    "EPSG:4326",
                    "EPSG:28992",
                    "none"
                ],
                "default":"EPSG:4326"
            },
            "minOccurs":0,
            "maxOccurs":1
        }
    },
    "outputs":{
        "features":{
            "title":"Features",
            "description":"The area and its centre, in GML 2.",
            "schema":{
                "type":"string",
                "contentMediaType":"text/xml",
                "contentSchema":"http://schemas.opengis.net/gml/2.1.2/feature.xsd"
            }
        }
    },
    "example":{
        "inputs":{
            "area":{
                "bbox":[
                    5.118,
                    52.089,
                    5.124,
                    52.093
                ]
            },
            "crs":"EPSG:4326"
        }
    },
    "outputTransmission":[
        "value"
    ]
}