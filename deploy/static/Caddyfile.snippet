# The static web client, and the relay at /api on the same origin. One site
# block, added to the host's existing Caddyfile; it changes nothing for any
# other site on the host. Replace oap.example.nl with the real hostname. See
# README.md here and in deploy/relay/.

oap.example.nl {
	# `current` is a relative symlink to releases/<id>, swapped atomically by
	# deploy.sh. Relative, so it also resolves inside a container that mounts
	# /srv/oap-web.
	root * /srv/oap-web/current

	# The relay (deploy/relay/). Caddy replaces any X-Forwarded-For a client
	# sends with the client's own address, and the relay trusts that header
	# from this proxy only. Bare /api is not a relay path: it falls through to
	# the file server, which answers 404. No `encode` here: compressing the
	# relay's answers would hold back its event stream and change
	# Content-Length, which the client reads as evidence.
	@api path /api/*
	handle @api {
		uri strip_prefix /api
		# 127.0.0.1, not localhost, which may resolve to ::1, where the relay
		# is not published. With Caddy in a container on the relay's network:
		# reverse_proxy oap-relay:8787
		reverse_proxy 127.0.0.1:8787
	}

	handle {
		# Vite puts a content hash in every file name under /assets/, so these
		# files never change: cache them for a year.
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"

		# Everything else (index.html, config.json) is revalidated, so a new
		# deploy shows up at once.
		@notAssets not path /assets/*
		header @notAssets Cache-Control "no-cache"

		# No SPA fallback: the app has no client-side routes, and answering a
		# missing /assets/ file with index.html would get that HTML cached for
		# a year as the asset. A missing file is a 404.
		encode zstd gzip
		file_server
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options DENY
		Permissions-Policy "geolocation=(), camera=(), microphone=()"
		# Report-only first: violations show in the browser console and break
		# nothing. Enforce after a clean end-to-end check (README.md).
		# connect-src https: is deliberately broad: a visitor may connect to
		# any HTTPS OGC API service.
		Content-Security-Policy-Report-Only "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' https: data: blob:; connect-src 'self' https:; worker-src 'self'; font-src 'self'; object-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
	}

	log
}
