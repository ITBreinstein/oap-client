{
  "method": "POST",
  "url": "{{baseUrl}}/processes/SAGA.pointcloud_tools.4/execution",
  "headers": {
    "Accept": "application/json",
    "Content-Type": "application/json"
  },
  "body": {
    "inputs": {
      "POINTS": {
        "value": "",
        "format": {
          "mediaType": "application/x-ogc-lasf",
          "encoding": "base64"
        }
      },
      "OUTPUT": "only z",
      "AGGREGATION": "mean value",
      "CELLSIZE": 0.005
    },
    "outputs": {
      "GRID": {
        "format": {
          "mediaType": "image/tiff"
        },
        "transmissionMode": "reference"
      },
      "COUNT": {
        "format": {
          "mediaType": "image/tiff"
        },
        "transmissionMode": "reference"
      }
    },
    "response": "document"
  }
}
