{
  "publicUrl": "http://host.docker.internal:8787",
  "allowedOrigins": ["http://localhost:4173", "http://localhost:5173"],
  "endpoints": [
    {
      "key": "pygeoapi-cors",
      "baseUrl": "http://localhost:5080",
      "executeRoute": "relay",
      "callbacks": true,
      "allowPrivateNetwork": true
    },
    {
      "key": "pygeoapi-nocors",
      "baseUrl": "http://localhost:5081",
      "executeRoute": "relay",
      "callbacks": false,
      "allowPrivateNetwork": true
    },
    {
      "key": "pygeoapi-nocors-relay",
      "baseUrl": "http://localhost:5081",
      "executeRoute": "relay",
      "readRoute": "relay",
      "callbacks": false,
      "allowPrivateNetwork": true
    },
    {
      "key": "weaver",
      "baseUrl": "http://localhost:5100",
      "executeRoute": "relay",
      "readRoute": "relay",
      "callbacks": false,
      "allowPrivateNetwork": true
    },
    {
      "key": "zoo",
      "baseUrl": "http://localhost:5090/ogc-api",
      "executeRoute": "relay",
      "readRoute": "relay",
      "callbacks": false,
      "allowPrivateNetwork": true
    }
  ],
  "rateLimits": {
    "perClient": {
      "sessionsPerMinute": 10000,
      "executesPerMinute": 10000,
      "readsPerMinute": 100000,
      "endpointsAndPreflightsPerMinute": 100000,
      "openStreams": 200,
      "inFlight": 200
    },
    "perEndpoint": {
      "requestsPerMinute": 100000,
      "inFlight": 200
    }
  }
}
