# The ZOO-Project reference deployment, pinned.
#
# Not the official ZOO-Project repository: a fork whose four patches are what
# make a headless OGC API - Processes deployment testable at all. See
# CODEX_FRESH_CLONE_FIX.md in that checkout, and infra/zoo/README.md here.
ZOO_FORK_REPO=https://github.com/Gouwe-Gozer/ZOO-Project.git
ZOO_FORK_SHA=46289f68b32c2388e0bb1190e42a243f29e33993

# Built from the checkout above. Tagged by fork SHA, never `local` or `latest`:
# a finding that names an image tag must name a rebuildable one.
ZOO_IMAGE=zoo-project:fork-46289f6

# The upstream image the fork's Dockerfile builds on top of. It writes
# `FROM zooproject/zoo-project:latest`, a moving tag; this is that tag's current
# commit, pinned so the base layer cannot shift under a rebuild.
ZOO_BASE_IMAGE=zooproject/zoo-project:19f3c4eed7c9ec9d1f0375bbe59f9d204a42bd3a
